<MudNavMenu>
    <MudText Typo="Typo.subtitle1" Class="px-4 py-4">VideoClub</MudText>
    <MudNavLink Href="" Match="NavLinkMatch.All">
        <MudIcon Icon="@Icons.Material.Filled.Home" Class="mr-2" /> Inicio
    </MudNavLink>
    <MudNavLink Href="clientes">
        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" /> Clientes
    </MudNavLink>
    <MudNavLink Href="articulos">
        <MudIcon Icon="@Icons.Material.Filled.Movie" Class="mr-2" /> Artículos
    </MudNavLink>
    <MudNavLink Href="rentas">
        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" /> Rentas
    </MudNavLink>

    <MudDivider Class="my-2" />

    <MudText Typo="Typo.body2" Class="px-4 py-2">
        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
        @_currentUser
    </MudText>
    <MudButton Variant="Variant.Text" Color="Color.Default"
               FullWidth="true" Class="px-4"
               OnClick="@LogoutAsync">
        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-1" />
        Cerrar sesión
    </MudButton>
</MudNavMenu>

@code {
    [Inject] private IAuthService AuthService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private CustomAuthStateProvider AuthStateProvider { get; set; } = null!;

    private string? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        AuthStateProvider.NotifyStateChanged();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
