@page "/elenco/roles"
@attribute [Authorize(Roles = "Administrador")]
@inject IRolElencoService RolElencoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-3">Roles de Elenco</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <div Class="d-flex align-end gap-4 flex-wrap">
        <div Class="flex-grow-1" Style="min-width: 200px">
            <MudText Typo="Typo.body2" Class="vc-form-label">Buscar rol</MudText>
            <MudTextField @bind-Value="_searchTerm"
                          @bind-Value:after="LoadData"
                          DebounceInterval="300"
                          Immediate="true"
                          Placeholder="Descripción..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Dense="true"
                          Class="w-100" />
        </div>
        <MudButton Variant="Variant.Filled"
                    Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.Add"
                    style="height: 60px;"
                    OnClick="async () => await OpenForm(null)">
            Nuevo Rol
        </MudButton>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="mx-auto my-8" />
}
else
{
    <MudTable Items="@_filteredRoles"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              Striped="true"
              Elevation="1"
              Class="mud-table-sticky-header">
        <HeaderContent>
            <MudTh>Descripción</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
            <MudTd DataLabel="Acciones">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Title="Editar"
                               OnClick="async () => await OpenForm(context)" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="[10, 25, 50]" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<RolElencoDto> _roles = [];
    private List<RolElencoDto> _filteredRoles = [];
    private string _searchTerm = "";
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _roles = await RolElencoService.GetAllAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar roles: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilter()
    {
        var query = _roles.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
            query = query.Where(r => r.Descripcion.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        _filteredRoles = query.OrderBy(r => r.Descripcion).ToList();
    }

    private async Task OpenForm(RolElencoDto? rol)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        var parameters = new DialogParameters
        {
            ["Tipo"] = "Rol",
            ["EditId"] = rol?.Id,
            ["EditName"] = rol?.Descripcion ?? ""
        };

        var dialog = await DialogService.ShowAsync<Form>(rol is null ? "Nuevo Rol" : "Editar Rol", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await LoadData();
    }
}
