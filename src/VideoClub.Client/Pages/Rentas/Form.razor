@page "/rentas/nueva"
@attribute [Authorize]
@inject IRentaService RentaService
@inject IClienteService ClienteService
@inject IArticuloService ArticuloService
@inject IEmpleadoService EmpleadoService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudText Typo="Typo.h5" Class="mb-3">Nueva Renta</MudText>

<MudForm @ref="_form">
    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Información de la Renta</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Class="vc-form-label">Cliente</MudText>
                <MudAutocomplete T="ClienteDto" @bind-Value="_selectedCliente"
                                 Label=""
                                 Placeholder="Buscar cliente por nombre o cédula..."
                                 Variant="Variant.Outlined"
                                 SearchFunc="@SearchClientes"
                                 ToStringFunc="@(c => c is null ? "" : $"{c.Nombre} ({c.Cedula})")"
                                 Required="true"
                                 RequiredError="Seleccione un cliente"
                                 Class="mb-3" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Class="vc-form-label">Empleado</MudText>
                <MudSelect @bind-Value="_model.EmpleadoId"
                           Required="true"
                           RequiredError="Seleccione un empleado"
                           Variant="Variant.Outlined"
                           Class="mb-3">
                    @foreach (var emp in _empleados)
                    {
                        <MudSelectItem Value="emp.Id">@emp.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Class="vc-form-label">Fecha Renta</MudText>
                <MudTextField @bind-Value="_fechaRentaStr"
                              Variant="Variant.Outlined"
                              Disabled="true"
                              Class="mb-3" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="vc-form-label">Comentario</MudText>
                <MudTextField @bind-Value="_model.Comentario"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLines="5"
                              Class="mb-3" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Artículos Rentados</MudText>

        <MudTable Items="_detalles"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Striped="true"
                  Dense="true"
                  Elevation="0"
                  Class="mb-3 mud-table-sticky-header">
            <HeaderContent>
                <MudTh>Artículo</MudTh>
                <MudTh>Stock Disp.</MudTh>
                <MudTh>Monto/Día</MudTh>
                <MudTh>Cant. Días</MudTh>
                <MudTh>Monto Total</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Artículo">@context.ArticuloTitulo</MudTd>
                <MudTd DataLabel="Stock Disp.">
                    <MudText Color="@(context.ArticuloStock > 0 ? Color.Default : Color.Error)">
                        @context.ArticuloStock
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Monto/Día">
                    <MudNumericField @bind-Value="context.MontoPorDia"
                                     T="decimal"
                                     Variant="Variant.Outlined"
                                     Dense="true" />
                </MudTd>
                <MudTd DataLabel="Cant. Días">
                    <MudNumericField @bind-Value="context.CantidadDias"
                                     T="int"
                                     Variant="Variant.Outlined"
                                     Dense="true" />
                </MudTd>
                <MudTd DataLabel="Monto Total">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">
                        @((context.MontoPorDia * context.CantidadDias).ToString("N2"))
                    </MudText>
                </MudTd>
                <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" Title="Eliminar"
                               OnClick="@(() => _detalles.Remove(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudPaper Elevation="0" Outlined="true" Class="pa-3">
            <MudText Typo="Typo.body2" Class="mb-2">Agregar artículo</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ArticuloDto" @bind-Value="_newArticuloArticulo"
                                     Placeholder="Buscar artículo por título..."
                                     Variant="Variant.Outlined"
                                     Dense="true"
                                     SearchFunc="@SearchArticulos"
                                     ToStringFunc="@(a => a?.Titulo ?? "")" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                   Color="Color.Primary"
                                   Title="Agregar artículo"
                                   Disabled="@(_newArticuloArticulo is null)"
                                   OnClick="@AddDetalle" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Totales</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="vc-form-label">Total Renta</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary">@_totalRenta.ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="vc-form-label">Fecha Dev. Esperada</MudText>
                <MudText Typo="Typo.body1">@_fechaExpectedDevolucion?.ToString("dd/MM/yyyy")</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <div Class="d-flex justify-end gap-2 mb-5">
        <MudButton Variant="Variant.Text" Color="Color.Default"
                   OnClick="@(async () => Navigation.NavigateTo("/rentas"))">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@SaveAsync"
                   Disabled="@_saving"
                   StartIcon="@Icons.Material.Filled.Save">
            Guardar Renta
        </MudButton>
    </div>
</MudForm>

@code {
    private bool _saving;
    private MudForm _form = null!;
    private CreateRentaRequest _model = new();
    private List<EmpleadoDto> _empleados = [];
    private List<ArticuloDto> _articulosCache = [];
    private List<ClienteDto> _clientesCache = [];
    private ClienteDto? _selectedCliente;

    private class DetalleItem
    {
        public long ArticuloId { get; set; }
        public string ArticuloTitulo { get; set; } = "";
        public int ArticuloStock { get; set; }
        public decimal MontoPorDia { get; set; }
        public int CantidadDias { get; set; }
    }

    private List<DetalleItem> _detalles = [];
    private ArticuloDto? _newArticuloArticulo;
    private string _fechaRentaStr = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
    private DateTime? _fechaExpectedDevolucion;

    private decimal _totalRenta => _detalles.Sum(d => d.MontoPorDia * d.CantidadDias);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _empleados = await EmpleadoService.GetAllAsync();
            _clientesCache = await ClienteService.GetAllAsync();
            _articulosCache = await ArticuloService.GetAllAsync(estado: true);
        }
        catch { }
    }

    private async Task<IEnumerable<ClienteDto>> SearchClientes(string? search, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(search))
            return _clientesCache.Take(10);
        return _clientesCache
            .Where(c => c.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase)
                     || c.Cedula.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Take(10);
    }

    private async Task<IEnumerable<ArticuloDto>> SearchArticulos(string? search, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(search))
            return _articulosCache.Take(10);
        return _articulosCache
            .Where(a => a.Titulo.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Take(10);
    }

    private void AddDetalle()
    {
        if (_newArticuloArticulo is null) return;

        if (_detalles.Any(d => d.ArticuloId == _newArticuloArticulo.Id))
        {
            Snackbar.Add("Este artículo ya está en la lista", Severity.Warning);
            return;
        }

        _detalles.Add(new DetalleItem
        {
            ArticuloId = _newArticuloArticulo.Id,
            ArticuloTitulo = _newArticuloArticulo.Titulo,
            ArticuloStock = _newArticuloArticulo.Stock,
            MontoPorDia = _newArticuloArticulo.RentaPorDia,
            CantidadDias = _newArticuloArticulo.DiasRenta
        });

        UpdateFechaExpected();

        _newArticuloArticulo = null;
    }

    private void UpdateFechaExpected()
    {
        if (_detalles.Count == 0)
        {
            _fechaExpectedDevolucion = null;
            return;
        }
        var maxDays = _detalles.Max(d => d.CantidadDias);
        _fechaExpectedDevolucion = DateTime.Now.AddDays(maxDays);
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        if (_detalles.Count == 0)
        {
            Snackbar.Add("Debe agregar al menos un artículo", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var request = new CreateRentaRequest
            {
                NoRenta = "",
                ClienteId = _selectedCliente?.Id ?? 0,
                EmpleadoId = _model.EmpleadoId,
                FechaRenta = DateTime.UtcNow,
                Comentario = _model.Comentario,
                Detalles = _detalles.Select(d => new CreateRentaDetalleItem
                {
                    ArticuloId = d.ArticuloId,
                    CantidadDias = d.CantidadDias,
                    Comentario = null
                }).ToList()
            };

            await RentaService.CreateAsync(request);
            Snackbar.Add("Renta creada correctamente", Severity.Success);
            Navigation.NavigateTo("/rentas");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
