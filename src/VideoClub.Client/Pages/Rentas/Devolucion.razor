@page "/rentas/{Id:long}/devolucion"
@attribute [Authorize]
@inject IRentaService RentaService
@inject IArticuloService ArticuloService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudText Typo="Typo.h5" Class="mb-3">Registrar Devolución</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="mx-auto my-8" />
}
else if (_renta is null)
{
    <MudText Typo="Typo.body1" Color="Color.Error">Renta no encontrada</MudText>
}
else
{
    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Datos de la Renta</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Class="vc-form-label">No. Renta</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@_renta.NoRenta</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Class="vc-form-label">Cliente</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@_renta.ClienteNombre</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Class="vc-form-label">Empleado</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@_renta.EmpleadoNombre</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Class="vc-form-label">Fecha Renta</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@_renta.FechaRenta.ToString("dd/MM/yyyy")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Class="vc-form-label">Fecha Dev. Esperada</MudText>
                <MudText Typo="Typo.body1" Class="mb-3">@_renta.FechaExpectedDevolucion?.ToString("dd/MM/yyyy")</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Detalles de Devolución</MudText>

        @foreach (var detalle in _detallesEdit)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.body2" Class="vc-form-label">Artículo</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@detalle.ArticuloTitulo</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3" md="2">
                        <MudText Typo="Typo.body2" Class="vc-form-label">Monto/Día</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@detalle.MontoPorDia.ToString("N2")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3" md="1">
                        <MudText Typo="Typo.body2" Class="vc-form-label">Días</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@detalle.CantidadDias</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.body2" Class="vc-form-label">Dev. Esperada</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@detalle.FechaDevolucionEsperada?.ToString("dd/MM/yyyy")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.body2" Class="vc-form-label">Fecha Devolución Real</MudText>
                    <MudDatePicker @bind-Value="detalle.FechaDevolucionReal"
                                         @bind-Value:after="@(() => CalcularRetraso(detalle))"
                                         Variant="Variant.Outlined"
                                         Dense="true" />
                     </MudItem>
                     <MudItem xs="12" sm="6" md="2">
                         <MudText Typo="Typo.body2" Class="vc-form-label">Días Retraso</MudText>
                          <MudNumericField @bind-Value="detalle.DiasRetraso"
                                           @bind-Value:after="@(() => CalcularMontoRetraso(detalle))"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudText Typo="Typo.body2" Class="vc-form-label">Monto Retraso</MudText>
                        <MudNumericField @bind-Value="detalle.MontoRetraso"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         Min="0" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Class="vc-form-label">Comentario</MudText>
                        <MudTextField @bind-Value="detalle.Comentario"
                                      Variant="Variant.Outlined"
                                      Dense="true" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Totales</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="vc-form-label">Total Renta</MudText>
                <MudText Typo="Typo.h5">@(_renta.MontoTotal?.ToString("N2") ?? "0.00")</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="vc-form-label">Total Retraso</MudText>
                <MudText Typo="Typo.h5" Color="Color.Error">@_totalRetraso.ToString("N2")</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="vc-form-label">Total General</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary">@((_renta.MontoTotal ?? 0) + _totalRetraso).ToString("N2")</MudText>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.body2" Class="vc-form-label mt-4">Comentario General</MudText>
        <MudTextField @bind-Value="_comentarioGeneral"
                      Variant="Variant.Outlined"
                      Lines="3" />
    </MudPaper>

    <div Class="d-flex justify-end gap-2">
        <MudButton Variant="Variant.Text" Color="Color.Default"
                   OnClick="@(async () => Navigation.NavigateTo("/rentas"))">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@ConfirmarDevolucion"
                   Disabled="@_saving"
                   StartIcon="@Icons.Material.Filled.CheckCircle">
            Confirmar Devolución
        </MudButton>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private RentaWithDetailsDto? _renta;
    private bool _loading;
    private bool _saving;
    private List<DetalleEditModel> _detallesEdit = [];
    private string? _comentarioGeneral;
    private Dictionary<long, decimal> _montosEntregaTardia = [];
    private decimal _totalRetraso => _detallesEdit.Sum(d => d.MontoRetraso);

    private class DetalleEditModel
    {
        public long Id { get; set; }
        public long ArticuloId { get; set; }
        public string ArticuloTitulo { get; set; } = "";
        public decimal MontoPorDia { get; set; }
        public int CantidadDias { get; set; }
        public DateTime? FechaDevolucionEsperada { get; set; }
        public DateTime? FechaDevolucionReal { get; set; } = DateTime.Today;
        public int DiasRetraso { get; set; }
        public decimal MontoRetraso { get; set; }
        public string? Comentario { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRenta();
    }

    private async Task LoadRenta()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _renta = await RentaService.GetByIdAsync(Id);

            if (_renta is null)
            {
                Snackbar.Add("Renta no encontrada", Severity.Error);
                Navigation.NavigateTo("/rentas");
                return;
            }

            if (_renta.EstadoRenta != "Activa")
            {
                Snackbar.Add("Esta renta ya fue devuelta", Severity.Warning);
                Navigation.NavigateTo($"/rentas/{Id}");
                return;
            }

            _comentarioGeneral = _renta.Comentario;

            _detallesEdit = _renta.Detalles.Select(d => new DetalleEditModel
            {
                Id = d.Id,
                ArticuloId = d.ArticuloId,
                ArticuloTitulo = d.ArticuloTitulo,
                MontoPorDia = d.MontoPorDia,
                CantidadDias = d.CantidadDias,
                FechaDevolucionEsperada = d.FechaDevolucionEsperada,
                FechaDevolucionReal = DateTime.Today,
                DiasRetraso = 0,
                MontoRetraso = 0,
                Comentario = d.Comentario
            }).ToList();

            foreach (var detalle in _renta.Detalles)
            {
                try
                {
                    var articulo = await ArticuloService.GetByIdAsync(detalle.ArticuloId);
                    if (articulo is not null)
                        _montosEntregaTardia[detalle.ArticuloId] = articulo.MontoEntregaTardia;
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar renta: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void CalcularRetraso(DetalleEditModel detalle)
    {
        if (detalle.FechaDevolucionReal.HasValue && detalle.FechaDevolucionEsperada.HasValue)
        {
            var diff = (detalle.FechaDevolucionReal.Value.Date - detalle.FechaDevolucionEsperada.Value.Date).Days;
            detalle.DiasRetraso = Math.Max(0, diff);
        }
        else
        {
            detalle.DiasRetraso = 0;
        }
        CalcularMontoRetraso(detalle);
    }

    private void CalcularMontoRetraso(DetalleEditModel detalle)
    {
        if (_montosEntregaTardia.TryGetValue(detalle.ArticuloId, out var montoPorDia))
        {
            detalle.MontoRetraso = detalle.DiasRetraso * montoPorDia;
        }
    }

    private async Task ConfirmarDevolucion()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirmar Devolución",
            "¿Confirmar la devolución de esta renta?",
            yesText: "Sí, confirmar",
            cancelText: "Cancelar");

        if (confirmed != true) return;

        _saving = true;
        try
        {
            var request = new UpdateRentaRequest
            {
                NoRenta = _renta!.NoRenta,
                ClienteId = _renta.ClienteId,
                EmpleadoId = _renta.EmpleadoId,
                FechaRenta = _renta.FechaRenta,
                FechaExpectedDevolucion = _renta.FechaExpectedDevolucion,
                FechaDevolucionReal = DateTime.UtcNow,
                MontoTotal = _renta.MontoTotal,
                MontoRetraso = _totalRetraso,
                EstadoRenta = "Devuelta",
                Comentario = _comentarioGeneral,
                Detalles = _detallesEdit.Select(d => new UpdateRentaDetalleItem
                {
                    Id = d.Id,
                    ArticuloId = d.ArticuloId,
                    CantidadDias = d.CantidadDias,
                    FechaDevolucionReal = d.FechaDevolucionReal,
                    DiasRetraso = d.DiasRetraso,
                    MontoRetraso = d.MontoRetraso,
                    Comentario = d.Comentario,
                    Eliminar = false
                }).ToList()
            };

            await RentaService.UpdateAsync(Id, request);
            Snackbar.Add("Devolución registrada correctamente", Severity.Success);
            Navigation.NavigateTo("/rentas");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar devolución: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
